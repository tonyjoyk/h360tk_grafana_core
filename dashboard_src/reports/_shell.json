            "kind": "DataQuery",
            "spec": {
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT COALESCE(MAX(1), 0) AS is_allowed\nFROM grafana_schema.user u\nLEFT OUTER JOIN grafana_schema.team_member tm ON tm.user_id = u.id\nLEFT OUTER JOIN grafana_schema.team t ON tm.team_id = t.id\nWHERE u.id = ${__user.id}\n  AND (\n      u.is_admin = true\n      OR (\n          NULLIF(NULLIF(TRIM(BOTH FROM '${org_unit}'), ''), '0') IS NULL\n          AND EXISTS (\n              SELECT 1\n              FROM heart360tk_schema.hierarchy_config hc\n              WHERE t.name IN (\n                  'heart360tk_' || hc.var_name || '_view_aggregated_ALL',\n                  'heart360tk_' || hc.var_name || '_view_patients_ALL'\n              )\n          )\n      )\n      OR (\n          NULLIF(NULLIF(TRIM(BOTH FROM '${org_unit}'), ''), '0') IS NOT NULL\n          AND (\n              t.name IN (\n                  SELECT (SELECT group_name FROM heart360tk_schema.get_access_groups(lin.ancestor_id, 'aggregated') LIMIT 1)\n                  FROM heart360tk_schema.org_unit_lineage lin\n                  WHERE lin.org_unit_id = NULLIF(NULLIF(TRIM(BOTH FROM '${org_unit}'), ''), '0')::int\n                  UNION\n                  SELECT (SELECT group_name FROM heart360tk_schema.get_access_groups(lin.ancestor_id, 'patients') LIMIT 1)\n                  FROM heart360tk_schema.org_unit_lineage lin\n                  WHERE lin.org_unit_id = NULLIF(NULLIF(TRIM(BOTH FROM '${org_unit}'), ''), '0')::int\n              )\n              OR EXISTS (\n                  SELECT 1\n                  FROM heart360tk_schema.hierarchy_config hc\n                  WHERE t.name IN (\n                      'heart360tk_' || hc.var_name || '_view_aggregated_ALL',\n                      'heart360tk_' || hc.var_name || '_view_patients_ALL'\n                  )\n                    AND hc.level <= (\n                      SELECT level FROM heart360tk_schema.org_units\n                      WHERE id = NULLIF(NULLIF(TRIM(BOTH FROM '${org_unit}'), ''), '0')::int\n               