# Copy to .env (git-ignored). Docker Compose reads this file for ${VAR} substitution.
# Leave the key blank: chat then answers offline from the same stored numbers.
# Never commit .env.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Defaults match the local demo.
# H360_API_DB_PASSWORD=h360_api_mvp
# H360_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# H360_GRAFANA_INTERNAL_URL=http://grafana:3000   # how h360-api reaches Grafana inside compose

# Host ports and container names. Leave these commented for a stock install (Grafana 3000,
# Postgres 5432, h360-api 8090, pgAdmin 5050, filebrowser 8080, containers named grafana, postgres ...).
# To run a second stack beside another one, uncomment all of them. See docs/running-two-stacks.md.
# H360_CONTAINER_PREFIX=demo-
# GRAFANA_PORT=3100
# POSTGRES_PORT=5532
# H360_API_PORT=8190        # must be GRAFANA_PORT + 5090: browser code finds h360-api that way
# PGADMIN_PORT=5150
# FILEBROWSER_PORT=8180
# H360_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
